# ==============================================================================
# BU Trade — Environment Variables Configuration
# ==============================================================================
# Copy this file to .env.local:
#   cp .env.example .env.local
#
# When NEXT_PUBLIC_SUPABASE_URL and NEXT_PUBLIC_SUPABASE_ANON_KEY are present,
# BU Trade automatically connects to real Supabase Auth (email OTP) and PostgreSQL.
# If these variables are empty, BU Trade runs in offline Mock Mode (test OTP: 123456).
# ==============================================================================

# Supabase Project Credentials (from your Supabase Dashboard -> Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Secret Service Role Key (for secure server actions & auth admin)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Mode switch: set to 'false' for live Supabase, or 'true' to force offline mock mode
NEXT_PUBLIC_USE_MOCK_DB=false

# (Optional) Custom SMTP / Resend API Key if using custom email domain for OTPs
# RESEND_API_KEY=re_123456789
